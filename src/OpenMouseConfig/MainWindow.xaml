<Window x:Class="OpenMouseConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenMouseConfig.ViewModels"
        xmlns:svc="clr-namespace:OpenMouseConfig.Services"
        xmlns:b="clr-namespace:OpenMouseConfig.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OpenMouseConfig"
        Width="1200" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshDevicesCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- header: device selector, status, battery -->
      <RowDefinition Height="Auto" /> <!-- unverified-definition banner -->
      <RowDefinition Height="*" />    <!-- settings cards / empty state -->
      <RowDefinition Height="Auto" /> <!-- developer console -->
      <RowDefinition Height="Auto" /> <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- ================================================================== HEADER -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brush.AccentSoft}">
            <TextBlock Text="&#xE962;" FontFamily="{StaticResource Font.Icons}" FontSize="18"
                       Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="OpenMouseConfig" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Native HID configurator" FontSize="11" Foreground="{StaticResource Brush.TextDim}" />
          </StackPanel>
        </StackPanel>

        <!-- Device selector -->
        <Grid Grid.Column="1" Width="380" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                    AutomationProperties.Name="Device" ToolTip="Supported mice found on USB (matched via devices.json)">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DeviceOptionViewModel}">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Brush.TextDim}" Margin="0,1,0,0" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="No supported mouse detected" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Margin="8,0,0,0" Content="&#xE72C;"
                Command="{Binding RefreshDevicesCommand}" ToolTip="Rescan USB devices (F5)" AutomationProperties.Name="Rescan" />

        <!-- Status: dry-run, connection, battery -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Pill}" Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}"
                  Visibility="{Binding IsSimulating, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Dry-run: packets are built and shown in the developer console, but not sent to the mouse.">
            <TextBlock Text="DRY RUN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
          </Border>

          <Border Style="{StaticResource Pill}" Margin="10,0,0,0" ToolTip="{Binding ConnectionDetail}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrush}}" />
              <TextBlock Text="{Binding ConnectionText}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                  Visibility="{Binding Features.Battery, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Battery level reported by the mouse (polled while connected)">
            <StackPanel Orientation="Horizontal">
              <!-- Battery glyph drawn with shapes so it doesn't depend on icon font versions. -->
              <Grid Width="26" Height="13" VerticalAlignment="Center">
                <Border BorderBrush="{StaticResource Brush.TextDim}" BorderThickness="1.5" CornerRadius="3" Margin="0,0,3,0" />
                <Border Width="2.5" Height="5" HorizontalAlignment="Right" CornerRadius="0,1,1,0" Background="{StaticResource Brush.TextDim}" />
                <Border HorizontalAlignment="Left" Margin="3,3,0,3" CornerRadius="1"
                        Width="{Binding BatteryPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=17}"
                        Background="{Binding BatteryPercent, Converter={StaticResource BatteryLevelToBrush}}" />
              </Grid>
              <TextBlock Text="{Binding BatteryText}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                         Foreground="{StaticResource Brush.Warning}" ToolTip="Charging"
                         Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================================== UNVERIFIED BANNER -->
    <Border Grid.Row="1" Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}"
            BorderThickness="0,0,0,1" Padding="22,10"
            Visibility="{Binding ShowUnverifiedBanner, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                   Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
          <Run Text="Unverified definition." FontWeight="SemiBold" Foreground="{StaticResource Brush.Warning}" />
          <Run Text="{Binding UnverifiedBannerText, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- ================================================================== CONTENT -->
    <Grid Grid.Row="2">

      <!-- Empty state -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24"
                  Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
        <Border Width="68" Height="68" CornerRadius="18" Background="{StaticResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
          <TextBlock Text="&#xE962;" FontFamily="{StaticResource Font.Icons}" FontSize="30" Foreground="{StaticResource Brush.TextDim}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
        <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button Style="{StaticResource Button.Primary}" Content="Rescan" Command="{Binding RefreshDevicesCommand}" />
          <Button Content="Show offline definitions" Margin="10,0,0,0" Command="{Binding EnableOfflineDevicesCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Settings -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="24,22,24,24" MaxWidth="1280" IsEnabled="{Binding CanEdit}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="440" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="5*" MinWidth="360" />
          </Grid.ColumnDefinitions>

          <!-- ============================================ DPI card -->
          <Border Style="{StaticResource Card}" VerticalAlignment="Top" IsEnabled="{Binding Features.Dpi}">
            <StackPanel>
              <TextBlock Text="Sensitivity (DPI)" Style="{StaticResource Text.CardTitle}" />
              <TextBlock Text="{Binding DpiRangeText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,10" />

              <ItemsControl ItemsSource="{Binding DpiStages}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DpiStageViewModel}">
                    <Grid Margin="0,9">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <RadioButton Style="{StaticResource StageBadge}" Content="{Binding Number}" Tag="{Binding Color}"
                                   IsChecked="{Binding IsActive}"
                                   IsEnabled="{Binding DataContext.Features.ActiveStage, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   ToolTip="Make this the active DPI stage"
                                   AutomationProperties.Name="Active stage" />

                      <!-- Minimum/Maximum are set before Value so the initial value is never clamped to the default range. -->
                      <Slider Grid.Column="1" Margin="16,0"
                              Minimum="{Binding Min}" Maximum="{Binding Max}"
                              SmallChange="{Binding Step}" LargeChange="{Binding LargeStep}"
                              TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                              Value="{Binding Dpi}"
                              AutomationProperties.Name="DPI" />

                      <TextBox Grid.Column="2" Width="88" TextAlignment="Right" FontWeight="SemiBold"
                               Text="{Binding Dpi, UpdateSourceTrigger=LostFocus}"
                               b:TextBoxBehaviors.CommitOnEnter="True"
                               ToolTip="Type a value and press Enter" AutomationProperties.Name="DPI value" />
                      <TextBlock Grid.Column="3" Text="DPI" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource Brush.TextDim}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                         Text="Click a numbered badge to choose the active stage. Slider changes are sent 250 ms after you stop dragging; for exact values, type into the box and press Enter." />
            </StackPanel>
          </Border>

          <!-- ============================================ Right column -->
          <StackPanel Grid.Column="2">

            <!-- Performance card -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Performance" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,16" />

                <!-- Polling rate -->
                <Grid IsEnabled="{Binding Features.PollingRate}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Polling rate" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="Reports per second. 4000–8000 Hz needs the 8K receiver and a fast CPU."
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                            ItemsSource="{Binding PollingRates}" SelectedItem="{Binding SelectedPollingRate}"
                            AutomationProperties.Name="Polling rate">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Border Style="{StaticResource Divider}" />

                <!-- Debounce -->
                <StackPanel IsEnabled="{Binding Features.Debounce}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Debounce, StringFormat={}{0} ms}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Debounce time" Style="{StaticResource Text.Label}" />
                  </DockPanel>
                  <TextBlock Text="How long a switch must settle before a click registers. Lower is faster; raise it if you get double-clicks."
                             Style="{StaticResource Text.Caption}" Margin="0,3,0,10" />
                  <Slider Minimum="{Binding DebounceMin}" Maximum="{Binding DebounceMax}"
                          TickFrequency="{Binding DebounceStep}" SmallChange="{Binding DebounceStep}" LargeChange="2"
                          IsSnapToTickEnabled="True" Value="{Binding Debounce}"
                          AutomationProperties.Name="Debounce time" />
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding DebounceMin, StringFormat={}{0} ms}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding DebounceMax, StringFormat={}{0} ms}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                  </DockPanel>
                </StackPanel>

                <Border Style="{StaticResource Divider}" />

                <!-- Lift-off distance -->
                <Grid IsEnabled="{Binding Features.LiftOffDistance}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Lift-off distance" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="Height at which the sensor stops tracking when you lift the mouse."
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Column="1" Style="{StaticResource SegmentedControl}" VerticalAlignment="Center"
                           ItemsSource="{Binding LiftOffDistances}" SelectedItem="{Binding SelectedLiftOffDistance}"
                           AutomationProperties.Name="Lift-off distance">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0:0.#} mm}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <Border Style="{StaticResource Divider}" />

                <!-- Motion Sync -->
                <Grid IsEnabled="{Binding Features.MotionSync}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Motion Sync" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="Aligns sensor frames with USB polling for more consistent tracking, at the cost of a little latency."
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MotionSync}"
                            AutomationProperties.Name="Motion Sync" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Device card -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="Device" Style="{StaticResource Text.CardTitle}" />
                <Grid Margin="0,14,0,0">
                  <Grid.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="Margin" Value="0,3" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Text="Model" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,18,3" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.DisplayName}" FontWeight="SemiBold" />

                  <TextBlock Grid.Row="1" Text="USB" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,18,3" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Identity}" Style="{StaticResource Text.Mono}" Margin="0,3" />

                  <TextBlock Grid.Row="2" Text="HID collection" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,18,3" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.Collection}" Style="{StaticResource Text.Mono}" Margin="0,3" />

                  <TextBlock Grid.Row="3" Text="Report sizes" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,18,3" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.Reports}" Style="{StaticResource Text.Mono}" Margin="0,3" />

                  <TextBlock Grid.Row="4" Text="Definition" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,18,3" />
                  <TextBlock Grid.Row="4" Grid.Column="1" ToolTip="{Binding SelectedDevice.DefinitionPath}">
                    <Run Text="{Binding SelectedDevice.DefinitionFile, Mode=OneWay}" />
                    <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" />
                    <Run Text="{Binding SelectedDevice.VerifiedText, Mode=OneWay}" Foreground="{StaticResource Brush.TextDim}" />
                  </TextBlock>
                </Grid>

                <TextBlock Text="{Binding SelectedDevice.Notes}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                           Visibility="{Binding SelectedDevice.HasNotes, Converter={StaticResource BoolToVisibility}}" />

                <WrapPanel Margin="0,18,0,0">
                  <Button Content="Read from mouse" Command="{Binding ReadFromDeviceCommand}" IsEnabled="{Binding Features.ReadBack}"
                          ToolTip="Run the definition's onConnect reads and update the UI" Margin="0,0,8,0" />
                  <Button Content="Write all settings" Command="{Binding WriteAllCommand}"
                          ToolTip="Send every setting shown here to the mouse (respects dry-run)" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- ================================================================== DEVELOPER CONSOLE -->
    <Border Grid.Row="3" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,7">
          <ToggleButton Style="{StaticResource ToggleButton.Expander}" IsChecked="{Binding IsConsoleExpanded}" HorizontalAlignment="Left">
            <TextBlock Text="Developer console" FontWeight="SemiBold" />
          </ToggleButton>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Dry run" IsChecked="{Binding DryRun}"
                      ToolTip="Build and log every packet, but don't send anything to the mouse." />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show offline definitions" Margin="20,0,0,0"
                      IsChecked="{Binding ShowOfflineDevices}"
                      ToolTip="List every definition even if the mouse isn't plugged in (always dry-run). Handy for checking payloads." />
            <Button Style="{StaticResource Button.Link}" Content="List HID interfaces" Margin="20,0,0,0"
                    Command="{Binding ListHidInterfacesCommand}"
                    ToolTip="Log every HID collection with VID, PID, usage page and report sizes" />
            <Button Style="{StaticResource Button.Link}" Content="Copy log" Margin="6,0,0,0" Command="{Binding CopyLogCommand}" />
            <Button Style="{StaticResource Button.Link}" Content="Clear" Margin="6,0,0,0" Command="{Binding ClearLogCommand}" />
          </StackPanel>
        </Grid>

        <Grid Height="250" Margin="16,0,16,14" Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                  CornerRadius="8" Padding="10,6">
            <ListBox Style="{StaticResource LogList}" ItemsSource="{Binding LogEntries}" b:ListBoxBehaviors.AutoScroll="True">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:LogEntry}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Tag}" FontWeight="Bold"
                               Foreground="{Binding Kind, Converter={StaticResource LogKindToBrush}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Raw packet sender: replay a captured report byte-for-byte. -->
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox FontFamily="{StaticResource Font.Mono}"
                     Text="{Binding RawHex, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Raw report in hex, byte 0 = report ID (e.g. 05 01 00 …) — Enter to send"
                     b:TextBoxBehaviors.EnterCommand="{Binding SendRawCommand}"
                     AutomationProperties.Name="Raw report" />
            <ComboBox Grid.Column="1" Width="112" Margin="10,0,0,0"
                      ItemsSource="{Binding RawReportKinds}" SelectedItem="{Binding RawReportKind}"
                      ToolTip="Send as feature report (SET_REPORT) or output report (interrupt OUT)" />
            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="Read reply" Margin="14,0,0,0"
                      IsChecked="{Binding RawReadResponse}"
                      ToolTip="After sending, read one reply (type from transport.responseType) and log it" />
            <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Content="Send" Margin="14,0,0,0"
                    Command="{Binding SendRawCommand}" />
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ================================================================== STATUS BAR -->
    <Border Grid.Row="4" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Link}" Content="Open definitions folder" Command="{Binding OpenDefinitionsFolderCommand}"
                  ToolTip="%APPDATA%\OpenMouseConfig\devices — your own *.json definitions go here" />
          <Button Style="{StaticResource Button.Link}" Content="Reload definitions" Margin="6,0,0,0" Command="{Binding ReloadDefinitionsCommand}"
                  ToolTip="Re-read devices.json and your user definitions without restarting" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding DefinitionsSummary, Mode=OneWay}" />
          <Run Text="   " />
          <Run Text="{Binding LastAction, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
        </TextBlock>
      </DockPanel>
    </Border>
  </Grid>
</Window>
