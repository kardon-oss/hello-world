<Application x:Class="OpenMouseConfig.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenMouseConfig.Converters"
             ShutdownMode="OnMainWindowClose">
  <!-- No StartupUri: App.OnStartup composes the services and creates the window. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrush" />
      <conv:LogKindToBrushConverter x:Key="LogKindToBrush" />
      <conv:PercentToWidthConverter x:Key="PercentToWidth" />
      <conv:BatteryLevelToBrushConverter x:Key="BatteryLevelToBrush" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
